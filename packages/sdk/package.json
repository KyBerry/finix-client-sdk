{
  "name": "@kyberry/finix-client-sdk",
  "version": "0.1.0",
  "description": "Typed headless browser and React bindings for the official Finix.js v2 SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsx scripts/fix-declaration-imports.ts",
    "check-types": "tsc --noEmit && tsc --noEmit --project tsconfig.tooling.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:live": "playwright test --config scripts/live-canary/playwright.config.ts",
    "coverage": "vitest run --coverage",
    "pack:verify": "tsx scripts/verify-package.ts",
    "prepack": "pnpm run build && tsx scripts/stage-package-docs.ts",
    "postpack": "tsx scripts/cleanup-package-docs.ts",
    "release:check": "pnpm run lint && pnpm run check-types && pnpm run test:ci && pnpm run pack:verify"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KyBerry/finix-client-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/KyBerry/finix-client-sdk#readme",
  "bugs": {
    "url": "https://github.com/KyBerry/finix-client-sdk/issues"
  },
  "keywords": [
    "finix",
    "payments",
    "credit card",
    "tokenization",
    "bank account",
    "headless",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": "Kyle Berry",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "csstype": "^3.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@kyberry/eslint-config": "workspace:*",
    "@kyberry/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/utils": "^8.15.0",
    "@types/node": "^22.13.9",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.1",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.1.2",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^3.9.1"
  }
}
